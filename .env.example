# Local CLI
#
# No environment variables are required for normal CLI use.
# Login discovers Todomate's public Firebase web config automatically.
#
# Optional overrides:
# TODOMATE_CONFIG_DIR="/path/to/private/config"
# TODOMATE_FIREBASE_API_KEY="public-firebase-web-api-key"
#
# Disabled by default. Set only for an intentional CLI or server chat-send.
TODOMATE_ENABLE_SOCIAL_WRITES="false"

# Optional HTTP server
#
# These values aren't required by the local CLI.
TODOMATE_PORT="3000"
SESSION_TTL_DAYS="30"
CORS_ORIGIN="*"

# Required public Firebase client config for HTTP server login (no auto-discovery).
# TODOMATE_FIREBASE_API_KEY="public-firebase-web-api-key"

# Required only for HTTP API bearer sessions.
# Generate with: openssl rand -hex 32
# SESSION_ENCRYPTION_KEY="paste-64-hex-characters-here"
